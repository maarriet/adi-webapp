# Prisma / Supabase Postgres
# DATABASE_URL: pooler en modo transacción (puerto 6543), usado en runtime por la app.
DATABASE_URL="postgresql://postgres:password@localhost:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexión directa (puerto 5432), usada solo por `prisma migrate`/`db push`.
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Resend — email de notificación cuando se crea una reserva nueva
# (lib/actions/reservations.ts). Si falta cualquiera de las dos, el envío
# se omite silenciosamente (solo un console.error) y la reserva se confirma
# igual — nunca bloquea el flujo.
RESEND_API_KEY=""
NOTIFICATION_EMAIL=""

# Contraseña compartida para /admin/agenda (Basic Auth vía middleware.ts).
# El "usuario" del diálogo del navegador se ignora, solo se valida esto.
ADMIN_PASSWORD=""
